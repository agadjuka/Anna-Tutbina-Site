# Скопируйте в .env.local и подставьте значения из настроек проекта Sanity
# (sanity.io → проект → API). Все переменные NEXT_PUBLIC_* попадают в клиентский
# бандл — секретов здесь быть не должно.

# ID проекта Sanity. Текущий продакшен-проект: см. sanity/sanity.config.ts
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Датасет Sanity
NEXT_PUBLIC_SANITY_DATASET=production

# Версия API Sanity (по умолчанию в коде: 2024-01-01)
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01
